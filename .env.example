# Neon Postgres pooled connection string (server-only)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Vercel Blob read/write token (server-only)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_REPLACE_ME

# Generate at least 32 random bytes; keep the same value across deployments
EDIT_TOKEN_PEPPER=replace-with-a-long-cryptographically-random-secret

# Vercel Cron bearer secret; use at least 16 cryptographically random characters
CRON_SECRET=replace-with-a-long-cryptographically-random-secret
